{
  "name": "llm-ide",
  "description": "Standalone local LLM IDE platform",
  "version": "0.0.1",
  "main": "./out/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p ./",
    "compile": "npm run build",
    "watch": "tsc -w -p ./",
    "start": "electron .",
    "dev": "npm run build && electron ."
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^31.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "monaco-editor": "^0.52.2",
    "simple-git": "^3.0.0"
  }
}