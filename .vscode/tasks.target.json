{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AI: Show Rules Checklist",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Get-Content -Raw '.ai-rules/RULES-QUICKREF.md'"
      ],
      "problemMatcher": []
    },
    {
      "label": "AI: Show Full Rules",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Get-Content -Raw '.ai-rules/rules.md'"
      ],
      "problemMatcher": []
    },
    {
      "label": "AI: Open Rules in Editor",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "if (Get-Command code -ErrorAction SilentlyContinue) { code -r '.ai-rules/RULES-QUICKREF.md' '.ai-rules/rules.md' } else { Write-Host 'VS Code CLI not found on PATH. Open .ai-rules/RULES-QUICKREF.md and .ai-rules/rules.md manually.' }"
      ],
      "problemMatcher": []
    }
  ]
}
